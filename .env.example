# Copy to .env and fill in — same conventions as Asia-NY
DISCORD_WEBHOOK=

BROKER=etoro

# --- eToro (api-portal.etoro.com, key from account settings, verified account) ---
ETORO_MODE=demo
ETORO_PUBLIC_KEY=
ETORO_USER_KEY=
ETORO_GOLD_SYMBOL=GOLD.24-7
ETORO_JPY_SYMBOL=USDJPY

ACCOUNT_SIZE=10000
RISK_PCT=1.0
RISK_MODE=each
SKIP_SUNDAY=1

RISK_USD=100
